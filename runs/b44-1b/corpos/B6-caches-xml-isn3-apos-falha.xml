<?xml version="1.0"?>
<infinispan xmlns="urn:infinispan:config:15.0">
    <cache-container>
        <caches>
            <distributed-cache name="counters" owners="2" segments="64" mode="SYNC" remote-timeout="17500" statistics="true">
                <locking concurrency-level="1000" acquire-timeout="15000" striping="false"/>
                <state-transfer enabled="true" timeout="60000"/>
                <partition-handling when-split="DENY_READ_WRITES" merge-policy="PREFERRED_NON_NULL"/>
            </distributed-cache>
        </caches>
    </cache-container>
</infinispan>
